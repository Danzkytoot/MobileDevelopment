<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Activity History" android:textSize="20sp" android:textStyle="bold" />
    <ListView android:id="@+id/lvHistory" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="No activity yet." android:visibility="gone" />
    <Button android:id="@+id/btnClear" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Clear history" />
</LinearLayout>
